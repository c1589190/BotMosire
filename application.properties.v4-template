# ==========================================
# V4 Core 完整配置模板
# 将需要的项取消注释并填入 application.properties
# ==========================================

# -- 认知准备池 --
#v4.core.baselineThreshold=0.3
#v4.core.continueWeightDecay=0.9
#v4.core.maxContinueWeight=5.0
#v4.core.maxPoolSize=32
#v4.core.maxTicksWithoutSelect=20
#v4.core.cognitiveTickMs=2000
#v4.core.topNActionPredicts=5
#v4.core.scalePerUENode=2
#v4.core.singleBoostCap=1.0

# -- 感觉维度 --
#v4.core.habituationLimit=10
#v4.core.bfsMaxLayers=3
#v4.core.bfsLayerDecay=0.7
#v4.core.dedupThreshold=0.85

# -- LLM 自主规划：next_actions 的 SE 系数 --
# next_action SE = 源单元SE × seMultiplier × priority
# 默认 1.3 → 优先回复的 SE 高于原始消息，避免被系统自检抢占
#v4.nextAction.seMultiplier=1.3
# 没有 finish_action 时的续命任务 SE 系数
#v4.nextAction.continuedSeMultiplier=0.9
# 没有 tool_calls 时的续命任务 SE 系数
#v4.nextAction.noToolContinuedSeMultiplier=0.9
# 工具执行结果汇总入池的 SE 系数
#v4.nextAction.toolSummarySeMultiplier=0.3
# new_prepare_unit 继承 SE 的系数
#v4.nextAction.newPrepUnitSeMultiplier=0.7

# -- 桌面巡视 --
#v4.file.surveyIntervalTicks=8
#v4.file.idlePoolThreshold=2
#v4.file.inputBaseSE=0.6

# -- 认知自检 --
#v4.tick.selfCheckIntervalTicks=30
#v4.tick.selfCheckBaseSE=0.5
# 是否只在池空闲时触发自检（true=空闲才触发，防止抢占用户消息处理）
#v4.tick.selfCheckRequireIdle=true
# 自检的空闲判断阈值（池大小低于此值才触发）
#v4.tick.selfCheckIdleThreshold=3

# -- 注意力机制 --
#v4.attention.poolMax=100.0
#v4.attention.regenPerTick=5.0
#v4.attention.maxAttendUnits=5
#v4.attention.decayPerTick=0.05

# -- 注意力态度 --
#v4.attention.attitudeScale=0.5
#v4.attention.attitudeMax=1.0
#v4.attention.attitudeMin=-1.0
#v4.attention.attitudeDecay=0.002
#v4.attention.boostExternal=0.02
#v4.attention.boostEndogenous=0.05
#v4.attention.boostSelected=0.08

# -- 语义疲劳 --
#v4.fatigue.maxHistory=30
#v4.fatigue.decayRate=0.08
#v4.fatigue.sensitivity=2.5
#v4.fatigue.maxAgeTicks=200

# -- Chat 消息聚合 --
#v4.chat.batchMinMessages=3
#v4.chat.batchMaxWaitMs=5000
#v4.chat.batchCooldownMs=3000
#v4.chat.batchPrivateMinMessages=1

# -- 行动模板匹配 --
#v4.template.minToolRatio=0.6
#v4.template.minMatchCount=3
#v4.template.maxTemplates=5
